# Backend Environment Configuration Template
# Copy this file to .env for local development:
# cp .env.sample .env

# Server Application Port
APP_PORT="8080"

# PostgreSQL Database Configuration
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="your_postgres_password"
DB_NAME="collabnote"

# JWT Secret Keys
JWT_ACCESS_TOKEN="your_jwt_access_token_secret_key"
JWT_REFRESH_TOKEN="your_jwt_refresh_token_secret_key"

# Password Hashing Salt Rounds
BCRYPT_SALT=10
